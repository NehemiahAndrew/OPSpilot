# ------------------------------------------------------------------
# OpsPilot - environment template
# Copy to .env and fill in real values. NEVER commit real secrets.
# ------------------------------------------------------------------

# --- App -----------------------------------------------------------
APP_ENV=development             # development | test | production
DEBUG=true
LOG_LEVEL=INFO

# --- Backend API ---------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000   # comma-separated list (frontend origin)

# --- Frontend ------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- PostgreSQL (local / docker-compose) ---------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=opspilot
POSTGRES_DB=opspilot
# Full asyncpg DSN - overrides the individual POSTGRES_* vars when set
DATABASE_URL=postgresql://opspilot:opspilot@localhost:5432/opspilot
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=10

# --- Supabase (hosted) ---------------------------------------------
# Connection string from Supabase dashboard (transaction pooler recommended)
SUPABASE_DB_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- LLM (provider-agnostic; default OpenAI gpt-4o) ----------------
LLM_PROVIDER=openai             # openai | anthropic | deepseek
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
LLM_RETRIES=2

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Optional per-provider model overrides
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-sonnet-4-20250514
DEEPSEEK_MODEL=deepseek-chat

# --- Orchestration / SSE -------------------------------------------
RUN_TIMEOUT_SECONDS=300
ABORT_GRACE_SECONDS=5
MAX_EVIDENCE_ITEMS=50
SSE_RETRY_MS=3000
SSE_HEARTBEAT_SECONDS=15

# --- Evaluation ----------------------------------------------------
EVALUATION_CASES_PATH=./evaluation/cases/cases.json
EVALUATION_RESULTS_DIR=./evaluation/results
EVALUATION_TRAJECTORIES_DIR=./evaluation/trajectories
EVALUATION_JUDGE_PROVIDER=openai
EVALUATION_JUDGE_MODEL=gpt-4o

# --- Seed data -----------------------------------------------------
SEED_ON_STARTUP=true
SEED_DATASET=seed_demo